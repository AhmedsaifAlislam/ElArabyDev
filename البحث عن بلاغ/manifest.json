{
  "manifest_version": 3,
  "name": "مساعد البحث عن بلاغ",
  "version": "7.0.0",
  "description": "أتمتة البحث عن البلاغات واستخراج تقارير الإصلاح",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://elarabyiscrm2.azurewebsites.net/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "مساعد البحث عن بلاغ"
  },
  "content_scripts": [{
    "matches": ["https://elarabyiscrm2.azurewebsites.net/ASPPage/SelectReport.aspx*"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["xlsx.full.min.js"],
    "matches": ["https://elarabyiscrm2.azurewebsites.net/*"]
  }]
}
