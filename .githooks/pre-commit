#!/bin/sh
# ElArabyDev — Pre-commit gate
# ------------------------------------------------------------------
# يمنع أي commit يكسر البوابة (اختبارات + تطابق src/deploy).
# يُشغَّل فقط عند تغيير ملفات المصدر أو الأدوات — commits التوثيق تُمرّ سريعًا.
#
# التثبيت مرة واحدة لكل نسخة من المشروع:
#   git config core.hooksPath .githooks
# ------------------------------------------------------------------

staged=$(git diff --cached --name-only)

# لا تغييرات في المصدر/الأدوات ⇒ مرور صامت (بدون ضجيج في كل commit توثيق)
if ! echo "$staged" | grep -qE '^(src/|tools/)'; then
  exit 0
fi

# مخرجات البوابة تُحفظ في سجل داخل .git — لا تُعرض إلا عند الفشل،
# حتى لا تظهر رسائل PowerShell الحمراء المضللة عند النجاح.
log="$(git rev-parse --git-dir)/verify-precommit.log"

if ! powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify.ps1 -CheckDeploy >"$log" 2>&1; then
  cat "$log" >&2
  echo "" >&2
  echo "[pre-commit] ❌ فشل التحقق — تم رفض الـ commit." >&2
  echo "   1) شغّل النشر:      powershell -ExecutionPolicy Bypass -File tools\\deploy.ps1" >&2
  echo "   2) أعد إدراج:       git add src deploy" >&2
  echo "   3) أعد المحاولة:    git commit" >&2
  echo "   (التجاوز الاستثنائي فقط: git commit --no-verify)" >&2
  exit 1
fi

exit 0
