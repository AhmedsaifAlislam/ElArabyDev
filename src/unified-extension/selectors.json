  "_batchDelay": 1200,
  "_nextWaitTimeout": 10000,
  "_lookupTimeout": 6000,
  "_ordersSearchWait": 2000,
  "_retryCount": 3,

  "_PROBLEM_CODES_NOTE": "خريطة أكواد المشاكل — تم التحقق من GR01 للثلاجات",

  "problemCodes": [
    { "pattern": "تكييف|ac|air.?cond|split|شباك|inverter", "codes": ["*AC02", "*AC03"] },
    { "pattern": "بوتوجاز|طباخ|cooker",                    "codes": ["*GS04"] },
    { "pattern": "غسال(?!.*(اطباق|أطباق))",                "codes": ["*WM05"] },
    { "pattern": "ثلاج|مبرد|fridge",                        "codes": ["*GR01", "*GR02", "*GR03"] },
    { "pattern": "اطباق|أطباق|dish",                        "codes": ["*DW06"] },
    { "pattern": "سخان|heater",                             "codes": ["*HT01"] }
  ],

  "_PROBLEM_CODE_RULES_NOTE": "تصنيف أكواد المشاكل المشترك (الاوتو فيلينج + الكنترول بانل). forbiddenKeywords: الأكواد/الكلمات التي لا تُختار أبدًا.",

  "problemCodeRules": {
    "forbiddenKeywords": ["GI00", "GS08", "GR05", "SR00", "SR01", "WM04", "ترصيد", "تجار", "ارضي", "أرضي", "بلاغ"]
  },

  "_problemPickTimeoutMs_NOTE": "مهلة انتظار اختيار المستخدم لكود المشكلة قبل الاختيار العشوائي من المسموح (مللي ثانية).",
  "problemPickTimeoutMs": 30000,

  "_WORKFLOWS_NOTE": "خط سير الإضافة — المحرك سيقرأ هذه الخطوات تباعاً. action: نوع الإجراء, target: مفتاح من المحددات أو CSS مباشر",

  "workflows": {
    "page1_search": [
      { "action": "wait", "target": "ordersSearchInput", "timeout": 10000 },
      { "action": "type", "target": "ordersSearchInput", "value": "{{orderId}}" },
      { "action": "click", "target": "ordersSearchBtn" },
      { "action": "wait", "target": "ordersTableRow", "timeout": 12000 },
      { "action": "click_row", "target": "ordersViewLink", "matchText": "{{orderId}}" }
    ],
    "page1_fill": [
      { "action": "fill_lookup", "target": "brandInput", "btn": "brandBtn", "value": "{{brand}}" },
      { "action": "fill_lookup", "target": "modelInput", "btn": "modelBtn", "value": "{{model}}" },
      { "action": "fill", "target": "serial", "value": "{{serial}}" },
      { "action": "fill_lookup", "target": "modelInput2", "btn": "modelBtn", "value": "{{model2}}", "condition": "{{isAC}}" },
      { "action": "fill", "target": "serial2", "value": "{{serial2}}", "condition": "{{isAC}}" },
      { "action": "fill_select", "target": "statusSelect", "value": "{{status}}" },
      { "action": "fill", "target": "dateInput", "value": "{{date}}" }
    ]
  }
}