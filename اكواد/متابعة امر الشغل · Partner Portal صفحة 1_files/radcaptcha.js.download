var radcaptcha = {
	onClientLoad: function (o, e) {
		// when the captcha is loaded, refresh the image once because sometimes
		// it'll have an invalidated img url because of caching

		// retrieve the "Generate New Image" button and click it to get a new image
		var genNewImageBtn = o._element.getElementsByTagName("a");
		if (genNewImageBtn && genNewImageBtn.length > 0) {
			document.location = genNewImageBtn[0].href;
		}
	}
};

function initCaptchaTooltips() {
	var isBS5 = typeof bootstrap !== 'undefined' && typeof bootstrap.Tooltip !== 'undefined';
	var toggleAttr = isBS5 ? 'data-bs-toggle' : 'data-toggle';
	var placementAttr = isBS5 ? 'data-bs-placement' : 'data-placement';

	// Set tooltip attributes only — do not call .tooltip() directly. The page-level Bootstrap
	// tooltip delegate (entity-grid.js) initializes tooltips for any [data-bs-toggle=tooltip]
	// element. Calling .tooltip() here would create a second conflicting instance on the same
	// element, whose event listeners interfere with Telerik's click handlers for image refresh
	// and audio playback.
	$('a.rcRefreshImage').first()
		.attr(toggleAttr, 'tooltip')
		.attr(placementAttr, 'bottom')
		.attr('role', 'button');
	$('a.rcCaptchaAudioLink').first()
		.attr(toggleAttr, 'tooltip')
		.attr(placementAttr, 'bottom')
		.attr('role', 'button');
}

// Set tooltip attributes on initial page load and after every partial postback.
// Safe to run after audio postbacks too — only sets attributes, no .tooltip() call.
if (window.Sys && window.Sys.Application) {
	Sys.Application.add_load(function () {
		setTimeout(initCaptchaTooltips, 1000);
	});
}

// When "Generate new image" triggers an UpdatePanel partial postback, its DOM element is replaced.
// Bootstrap's mouseleave (which normally hides the tooltip) never fires on the removed element,
// leaving the tooltip orphaned in the body. Hide captcha tooltips before each partial postback
// so they are cleaned up before the DOM swap occurs.
if (window.Sys && window.Sys.WebForms && window.Sys.WebForms.PageRequestManager) {
	Sys.WebForms.PageRequestManager.getInstance().add_beginRequest(function () {
		try { $('.rcRefreshImage').first().tooltip('hide'); } catch (e) { }
		try { $('.rcCaptchaAudioLink').first().tooltip('hide'); } catch (e) { }
	});
}
