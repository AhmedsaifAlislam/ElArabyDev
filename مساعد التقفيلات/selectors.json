    ".entitylist-items li",
    ".lookup-results li"
  ],

  "lookupSearchInput": [
    "[role='dialog'] input[type='search']",
    "[role='dialog'] input[type='text']",
    ".lookup-modal input"
  ],

  "successIndicator": [
    ".save-success",
    ".alert-success",
    ".notification-success",
    "[class*='success']",
    ".toast-success"
  ],

  "customer": [
    ".customer-name",
    "[class*='customer-name']",
    "[data-id*='customer']"
  ],

  "orderNumber": [
    ".order-number",
    "[class*='order-id']",
    "[class*='workorder-id']"
  ],

  "_ORDERS_PAGE_SELECTORS_NOTE": "الـ selectors التالية خاصة بصفحة /Orders — عدّلها أولاً",

  "ordersSearchInput": [
    "input[aria-label*='Search']",
    "input[placeholder*='Search']",
    "input[placeholder*='بحث']",
    "#searchOrders",
    "input[type='search']",
    ".search-input input",
    "input[name*='search']"
  ],

  "ordersSearchBtn": [
    "button[type='submit']",
    "button[aria-label*='Search']",
    "button[aria-label*='بحث']",
    ".search-btn",
    "button[class*='search']"
  ],

  "ordersTableRow": [
    "table tbody tr",
    "[role='row']",
    ".entitylist-items > li",
    ".order-row",
    ".grid-row",
    ".list-item"
  ],

  "ordersViewLink": [
    "a[href*='workorderreview']",
    "a[href*='followup']",
    "a[href*='review']",
    "button[aria-label*='View']",
    "button[aria-label*='Open']",
    "button[aria-label*='متابعة']",
    "a[aria-label*='View']",
    "td:last-child a",
    ".view-btn"
  ],

  "_batchDelay": 1200,
  "_nextWaitTimeout": 10000,
  "_lookupTimeout": 6000,
  "_ordersSearchWait": 2000,
  "_retryCount": 3,

  "_PROBLEM_CODES_NOTE": "خريطة أكواد المشاكل — عدّل الـ pattern (regex) أو الـ codes حسب الحاجة",
  "problemCodes": [
    { "pattern": "تكييف|ac|air.?cond|split|شباك|inverter", "codes": ["*AC02", "*AC03"] },
    { "pattern": "بوتوجاز|طباخ|cooker",                    "codes": ["*GS04"] },
    { "pattern": "غسال(?!.*(اطباق|أطباق))",                "codes": ["*WM05"] },
    { "pattern": "ثلاج|مبرد|fridge",                        "codes": ["*GR01", "*GR02", "*GR03"] },
    { "pattern": "اطباق|أطباق|dish",                        "codes": ["*DW06"] },
    { "pattern": "سخان|heater",                             "codes": ["*HT01"] }
  ],

  "_WORKFLOWS_NOTE": "خط سير الإضافة — المحرك سيقرأ هذه الخطوات تباعاً. action: نوع الإجراء, target: مفتاح من المحددات أو CSS مباشر",
  "workflows": {
    "page1_search": [
      { "action": "wait", "target": "ordersSearchInput", "timeout": 10000 },
      { "action": "type", "target": "ordersSearchInput", "value": "{{orderId}}" },
      { "action": "click", "target": "ordersSearchBtn" },
      { "action": "wait", "target": "ordersTableRow", "timeout": 12000 },
      { "action": "click_row", "target": "ordersViewLink", "matchText": "{{orderId}}" }
    ]
  }
}
